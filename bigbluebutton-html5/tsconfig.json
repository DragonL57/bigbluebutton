{
  "compilerOptions": {
    /* Basic Options */
    "target": "es2018",
    "module": "esNext",
    "lib": ["esnext", "dom"],
    "allowJs": true,
    "checkJs": false,
    "jsx": "react",
    "incremental": true,
    "noEmit": true,
    "resolveJsonModule":true,
    "skipLibCheck": true,
    "types": [],
    "tsBuildInfoFile": "./node_modules/.cache/.tsbuildinfo",

    /* Strict Type-Checking Options */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    /* Additional Checks */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,

    /* Module Resolution Options */
    /* Paths are resolved against this file, so baseUrl is not needed and is removed in
       TypeScript 7. Bare specifiers need their own entry for the same reason. */
    "paths": {
      /* Support absolute /imports/* with a leading '/' */
      "/*": ["./*"],
      "/imports/": ["./imports/*"],
      "/client/": ["./client/*"],
      "imports/*": ["./imports/*"],
      "client/*": ["./client/*"]
    },
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "preserveSymlinks": true
  },
  "exclude": [
    "./dist/*",
    "./.meteor/**",
    "./packages/**",
    "node_modules",
    "./node_modules",
    "./node_modules/*",
    "./node_modules/@types/node/index.d.ts",
  ]
}